{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["C:\\Users\\pc\\owoworks\\AGENTS.md"],
  "agent": {
    "promota-orchestrator": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-backend-engineer": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-frontend-engineer": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-db-engineer": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-money-path-auditor": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-security-reviewer": { "model": "groq/openai/gpt-oss-120b" },
    "promota-test-engineer": { "model": "google_gemini/gemini-3.6-flash" },
    "promota-devops-engineer": { "model": "groq/openai/gpt-oss-120b" },
    "promota-release-gate": { "model": "groq/openai/gpt-oss-120b" },
    "promota-docs-keeper": { "model": "google_gemini/gemini-3.6-flash" }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "C:\\Users\\pc\\dev\\tools\\node\\node.exe",
        "C:\\Users\\pc\\.config\\opencode\\node_modules\\@modelcontextprotocol\\server-filesystem\\dist\\index.js",
        "C:\\Users\\pc\\owoworks"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "railway": {
      "type": "local",
      "command": ["railway", "mcp"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  },
  "permission": {
    "external_directory": "ask",
    "shell": {
      "*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "railway *": "ask",
      "npm publish*": "ask",
      "Remove-Item*": "ask",
      "rm -rf*": "deny"
    }
  },
  "subagent_depth": 2
}
